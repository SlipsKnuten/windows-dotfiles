;; ============================================================================
;; kanata.kbd — home row mods for Alt and Shift
;;
;; Goal: no more stretching for Shift. Hold a home-row key and it acts as
;; Alt/Shift; tap it and it types the letter. Only the left hand has mods;
;; Ctrl, Caps Lock and every other key are left alone.
;;
;;   Left hand
;;    a     s     d    f
;;   Alt  Shift   .    .
;;
;; Examples:
;;   Alt+j        -> hold a, press j
;;   Alt+w        -> hold a, press w
;;   capital J    -> hold s, press j
;;   capital A    -> hold s, press a
;;   Alt+Shift+H  -> hold a and s, press h
;; Capital S and Alt+a still need the real Shift/Alt key.
;;
;; How a press of a/s is decided:
;;   1. Mid-typing (any other key pressed in the last 150 ms): it is
;;      the letter, straight away. No waiting, and it can never turn into a mod.
;;   2. Otherwise it waits. Another key pressed AND released while a/s is still
;;      held makes it the mod; releasing a/s first types the letter. Rolling
;;      through "as" or "sa" therefore still types letters.
;;   3. Holding a/s for `hold-time` ms with no other key also makes it the mod.
;;
;; Emergency exit: physical Left Ctrl + Space + Esc kills kanata.
;;
;; Needs kanata v1.12.0+ (tap-hold-require-prior-idle). Same file as
;; omarchy-dotfiles/kanata/.config/kanata/kanata.kbd, so keep the two in sync.
;; ============================================================================

(defcfg
  ;; Every key not listed in defsrc passes through untouched.
  process-unmapped-keys yes
  ;; prior-idle, in ms. If mods misfire while typing, raise it. If a mod
  ;; won't come on right after typing (e.g. Alt+j mid-edit), lower it.
  tap-hold-require-prior-idle 150
)

(defvar
  ;; If holding feels sluggish before the mod kicks in, lower it.
  hold-time 200
  ;; Tap a/s and press it again within this many ms to hold the letter itself
  ;; (key repeat) instead of the mod.
  tap-time 200
)

(defsrc
  a   s
)

(deflayer base
  @a  @s
)

(defalias
  a (tap-hold-release $tap-time $hold-time a lalt)
  s (tap-hold-release $tap-time $hold-time s lsft)
)
